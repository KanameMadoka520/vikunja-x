# syntax=docker/dockerfile:1
FROM node:24.21.0-alpine@sha256:ebfe2f90462722a7a4de65e91990e97fe0d401c70e0e762c5b53302f905ec1c1 AS frontend
WORKDIR /build
ENV PUPPETEER_SKIP_DOWNLOAD=true CYPRESS_INSTALL_BINARY=0
COPY frontend/package.json frontend/pnpm-lock.yaml frontend/pnpm-workspace.yaml ./
RUN npm install -g corepack && corepack enable && pnpm install --frozen-lockfile
COPY frontend/ ./
ARG RELEASE_VERSION=v2.7.1-tcymc.23
RUN printf '{"VERSION":"%s"}\n' "$RELEASE_VERSION" > src/version.json && pnpm build

FROM golang:1.27.3-alpine@sha256:f2c872bcee949b7be9c490efd02b48a8a2fbf947cdf533f1c58525ec9d8170fd AS backend
RUN apk add --no-cache build-base ca-certificates tzdata
WORKDIR /build
ENV GOMAXPROCS=4 GOFLAGS=-p=4 CGO_ENABLED=1
COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod go mod download
COPY . ./
COPY --from=frontend /build/dist ./frontend/dist
ARG RELEASE_VERSION=v2.7.1-tcymc.23
RUN --mount=type=cache,target=/go/pkg/mod --mount=type=cache,target=/root/.cache/go-build \
    go build -trimpath -tags 'netgo osusergo' \
    -ldflags "-s -w -linkmode external -extldflags '-static' -X code.vikunja.io/api/pkg/version.Version=$RELEASE_VERSION" \
    -o /out/vikunja . && mkdir -p /out/tmp && chmod 1777 /out/tmp

FROM scratch
ARG RELEASE_VERSION=v2.7.1-tcymc.23
LABEL org.opencontainers.image.version="$RELEASE_VERSION" \
      org.opencontainers.image.authors="KanameMadoka520" \
      org.opencontainers.image.title="Vikunja X · tcymc二次开发版" \
      org.opencontainers.image.source="https://github.com/KanameMadoka520/vikunja-x" \
      org.opencontainers.image.licenses="AGPL-3.0-or-later"
WORKDIR /app/vikunja
COPY --from=backend /out/vikunja ./vikunja
COPY --from=backend /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/
COPY --from=backend /usr/share/zoneinfo /usr/share/zoneinfo
COPY --from=backend --chown=1000:1000 --chmod=1777 /out/tmp /tmp
USER 1000
ENV VIKUNJA_SERVICE_ROOTPATH=/app/vikunja/ VIKUNJA_DATABASE_PATH=/db/vikunja.db
EXPOSE 3456
ENTRYPOINT ["/app/vikunja/vikunja"]
